# Zoeken en persoonlijke AI — omgevingsvariabelen (voor ontwikkeling; GEEN echte waarden).
# De standaard TrueNAS Custom App heeft GEEN verplichte variabelen. Geheimen staan nooit hier: die maakt de app zelf
# in <SEARCH_AI_DATA_DIR>/secrets (vault.key, identity.ed25519). De ingebouwde database heeft geen wachtwoord.

# --- Koppeling met de Hub (platformcontract 1.3 §3.2) ---
# De Custom App heeft GEEN verplichte variabelen; deze drie zijn optioneel (bij installatie via de API zet de Hub ze).
# HUB_* zijn gereserveerd: nooit een manifestparameter (§3.2, §9).
# Adres van de Hub: http(s)://<host>[:<poort>] zonder pad, query of inloggegevens; geen loopback, link-local of 0.0.0.0.
# Een IP-adres alleen als a.b.c.d (geen 127.1 of 0x7f000001), IPv6 tussen [ ].
# Op de NAS: het LAN-adres van de NAS + poort van de Hub (uit de wizard, nooit aannemen).
HUB_URL=
# Eenmalig koppeltoken uit de Hub (enr_ + 43 tekens; vervalt na 60 min of na eerste gebruik). Leeg = koppelen via de
# koppelcode op de statuspagina (alleen zolang de dienst nog nooit gekoppeld is). De oude naam ENROLLMENT_TOKEN wordt
# in deze release nog gelezen, met een waarschuwing in de log.
HUB_ENROLLMENT_TOKEN=
# Verwachte vingerafdruk van de Hub-sleutels (XXXX-XXXX-XXXX-XXXX, niet geheim). Ingevuld ⇒ verplicht gecontroleerd.
HUB_KEY_FINGERPRINT=
# Adres waarop de Hub deze dienst bereikt (optioneel, alleen informatief: de Hub gebruikt zijn eigen register).
# Voldoet het niet aan de adresregels, dan stuurt de dienst base_url: null (§3.3).
SEARCH_AI_PUBLIC_URL=

# --- Dienst ---
# Datamap (in de image: /appdata).
SEARCH_AI_DATA_DIR=./.appdata
# SQLAlchemy-URL. In de image: postgresql+psycopg://search_ai@/search_ai?host=/tmp/search-ai-pg (unix-socket).
# Lokaal: een eigen database met prefix zoek_ op de ontwikkel-PostgreSQL (met pgvector).
SEARCH_AI_DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:5432/zoek_dev
# Poort van API + statuspagina.
SEARCH_AI_PORT=30450
# Map met Alembic-migraties (alleen nodig buiten de broncode; de image zet dit zelf).
SEARCH_AI_ALEMBIC_DIR=

# --- B07: lees-padenallowlist ---
# Leeswortels (komma-gescheiden). In de image: /bronnen. Systeemmappen, '/', '/mnt' en de datamap worden genegeerd.
SEARCH_AI_READ_ROOTS=./.bronnen
# Toestemming alleen voor alleen-lezen koppelingen (standaard aan; alleen in tests uit).
SEARCH_AI_REQUIRE_READONLY_MOUNTS=true
# Bovengrens voor de bronwizard-voorvertoning (alleen namen tellen, geen inhoud).
SEARCH_AI_PREVIEW_MAX_FILES=20000

# --- Beveiliging / afstelling ---
# Hub-sleutels worden bij het koppelen gepind in <data>/secrets/hub-link.json; er wordt nooit een JWKS opgehaald.
# Controle bij de Hub (services/self: bevestigen, intrekking en rotatieverzoek opmerken), in seconden; maximaal 240.
SEARCH_AI_HUB_SELF_CHECK_S=240
# Interval voor het pollen van ondertekende sleutelrotaties (seconden, 30–900; leeg = 600).
SEARCH_AI_KEY_ROTATION_POLL_S=
# Interval van de worker (seconden).
SEARCH_AI_WORKER_INTERVAL_S=10
# Verzoeklimiet voor zoeken: maximaal aantal zoekopdrachten per gebruiker per 60 s (per API-proces) → daarna 429.
SEARCH_AI_SEARCH_RATE_LIMIT=60
# Tijdlimiet per zoekopdracht in de database (milliseconden) → daarna 503 'zoeken_tijdslimiet'.
SEARCH_AI_SEARCH_STATEMENT_TIMEOUT_MS=5000
# ALLEEN ontwikkeling/tests: Hub op 127.0.0.1 toestaan (in de container wijst loopback naar zichzelf).
SEARCH_AI_ALLOW_LOOPBACK_HUB=

# --- Tests ---
# Beheer-URL van de PostgreSQL voor integratie-/E2E-tests (databases zoek_test_api en zoek_test_e2e).
SEARCH_AI_TEST_ADMIN_URL=
